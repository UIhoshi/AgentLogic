{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlogic.local/manifest.schema.json",
  "title": "AgentLogic Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "role",
    "description",
    "entry",
    "current_version",
    "main_logic_file",
    "default_profile",
    "profiles",
    "optional_modules",
    "host_outputs",
    "adapters",
    "notes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.md$"
    },
    "current_version": {
      "type": "string",
      "pattern": "^V[0-9A-Za-z._-]+$"
    },
    "main_logic_file": {
      "type": "string",
      "pattern": "^versions/AgentLogic_[^\\\\]+\\.md$"
    },
    "default_profile": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "files"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "optional_modules": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "host_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude",
        "gemini",
        "generic"
      ],
      "properties": {
        "codex": {
          "type": "string",
          "minLength": 1
        },
        "claude": {
          "type": "string",
          "minLength": 1
        },
        "gemini": {
          "type": "string",
          "minLength": 1
        },
        "generic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude",
        "gemini",
        "generic"
      ],
      "properties": {
        "codex": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        },
        "claude": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        },
        "gemini": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        },
        "generic": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
