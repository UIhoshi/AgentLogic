{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentlogic.local/manifest.schema.json",
  "title": "AgentLogic Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "role",
    "description",
    "entry",
    "current_version",
    "main_logic_file",
    "default_profile",
    "profiles",
    "optional_modules",
    "host_outputs",
    "adapters",
    "install",
    "notes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.md$"
    },
    "current_version": {
      "type": "string",
      "pattern": "^V[0-9A-Za-z._-]+$"
    },
    "main_logic_file": {
      "type": "string",
      "pattern": "^versions/AgentLogic_[^\\\\]+\\.md$"
    },
    "default_profile": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "files"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "optional_modules": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "host_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude",
        "antigravity",
        "generic"
      ],
      "properties": {
        "codex": {
          "type": "string",
          "minLength": 1
        },
        "claude": {
          "type": "string",
          "minLength": 1
        },
        "antigravity": {
          "type": "string",
          "minLength": 1
        },
        "generic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codex",
        "claude",
        "antigravity",
        "generic"
      ],
      "properties": {
        "codex": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        },
        "claude": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        },
        "antigravity": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        },
        "generic": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_profile",
        "stable_entry",
        "agent_guide",
        "human_guide",
        "doctor",
        "hosts",
        "validation"
      ],
      "properties": {
        "default_profile": {
          "type": "string",
          "minLength": 1
        },
        "stable_entry": {
          "type": "string",
          "pattern": "^[^\\\\]+\\.md$"
        },
        "agent_guide": {
          "type": "string",
          "pattern": "^[^\\\\]+\\.md$"
        },
        "human_guide": {
          "type": "string",
          "pattern": "^[^\\\\]+\\.md$"
        },
        "doctor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "script"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "script": {
              "type": "string",
              "pattern": "^scripts/.+\\.ps1$"
            }
          }
        },
        "hosts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codex",
            "claude",
        "antigravity",
            "generic"
          ],
          "properties": {
            "codex": {
              "$ref": "#/$defs/installHost"
            },
            "claude": {
              "$ref": "#/$defs/installHost"
            },
        "antigravity": {
              "$ref": "#/$defs/installHost"
            },
            "generic": {
              "$ref": "#/$defs/installHost"
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "script"
          ],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "script": {
              "type": "string",
              "pattern": "^scripts/.+\\.ps1$"
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "installHost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "adapter",
        "output"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "string",
          "pattern": "^adapters/.+/install\\.ps1$"
        },
        "output": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
